@x64


class point
{
    i32 x;
}

[noinline:true]
(i64 tmp)f(i32? res)
{
    res <- 1;
}

[noinline:true]
(point x)g(i32? res)
{
    x?x <- 10;
    res <- 1 + ?(1)f[on:remote](*);
}

[export:yes]
[entry:yes]
(i64[] input)main(i32? res) 
{
    point ptr;
    ptr <- new point();
    ptr?x <- 1;
    i32 tmp;
    tmp <- (?(0)f[on:local](*)) + (?(ptr)g[on:remote](*));
    res <- tmp + ptr?x;
}
    

